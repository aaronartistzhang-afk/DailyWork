# Group Discussion Reviewer — engine config
# Copy to .env and fill in, or export these in your shell.

# Required: API key for the LLM.
OPENAI_API_KEY=

# Endpoint. Leave unset to target the public OpenAI API (https://api.openai.com/v1)
# with bearer auth. Set this to your own OpenAI-compatible gateway endpoint.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Model id. Default: gpt-4.1-mini
# OPENAI_MODEL=gpt-4.1-mini

# Auth style:
#   bearer = Authorization: Bearer <key>, endpoint normalized to <baseUrl>/chat/completions
#   query  = key passed as ?ak=<key> on OPENAI_BASE_URL (for gateways that take the key in the URL)
# Default: bearer when OPENAI_BASE_URL is unset, otherwise query.
# OPENAI_AUTH_STYLE=bearer
